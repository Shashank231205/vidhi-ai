# Patterns without a slash match at any depth; `.venv` alone matched only the
# repository root, so backend/.venv was uploaded on every build — 1.2GB of
# context and ~80 seconds before the build even started.
**/.venv
**/node_modules
**/__pycache__
**/*.pyc
**/.next
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/*.egg-info
**/.coverage

.git
.github
.githooks

# The frontend deploys to Vercel; the eval harnesses run locally.
frontend
eval

# Trained weights are reproducible from ml/*/train.py and are not loaded in
# production — the agent falls back to the LLM path. metrics.json is small and
# worth keeping for reference.
ml/*/model/**
!ml/*/model/metrics.json
ml/*/checkpoints

# Credentials reach the container as runtime secrets, never through the image.
**/.env
**/.env.*
!**/.env.example

*.md
!README.md

# gcloud does not read .dockerignore when building from source, so the upload
# set is duplicated here. Without it the build context is ~1.2GB.
.dockerignore
fly.toml
