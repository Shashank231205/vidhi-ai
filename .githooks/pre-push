#!/usr/bin/env bash
# Runs the same gates CI runs, before the push rather than after it.
# A red main is worse than a slow push.
#
# Install:  make hooks     (or: git config core.hooksPath .githooks)
# Bypass:   git push --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)/backend"

echo "pre-push: ruff, mypy, tests (skip with --no-verify)"

if ! uv run ruff check . ; then
  echo "pre-push: lint failed" >&2
  exit 1
fi

if ! uv run ruff format --check . ; then
  echo "pre-push: formatting failed — run 'make format'" >&2
  exit 1
fi

if ! uv run mypy api core tests ; then
  echo "pre-push: typecheck failed" >&2
  exit 1
fi

# Integration tests need credentials CI does not have, so match CI exactly:
# unit tests only. Integration runs locally via `make test`.
if ! uv run pytest -q -m "not integration" ; then
  echo "pre-push: tests failed" >&2
  exit 1
fi

echo "pre-push: all gates passed"
